# Sahayak AI Backend Environment Configuration

# Database
DATABASE_URL=postgresql://sahayak_user:sahayak_password@localhost:5432/sahayak_db

# Embeddings (Phase 2 - Developer A)
EMBEDDING_MODEL=BAAI/bge-m3

# LLM Config (Phase 4 - Developer B / Me)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5
OLLAMA_TIMEOUT=20.0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Speech-to-Text (Phase 6)
STT_MODEL=small

# Text-to-Speech (Phase 7)
TTS_PROVIDER=gtts

# Hardware Security (Phase 8+)
ESP32_API_KEY=sahayak_secret_esp32_key_2026

# Server Config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
